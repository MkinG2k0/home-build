# Strapi API URL
# Для локальной разработки: http://localhost:1337/api
# Для продакшена: https://your-strapi-domain.com/api
VITE_STRAPI_API_URL=http://localhost:1337/api

# Strapi API Token (опционально)
# Если в Strapi настроен публичный доступ, токен не нужен
# Для получения токена: Settings > API Tokens > Create new API Token
# Тип: Read-only или Full access
VITE_STRAPI_API_TOKEN=
